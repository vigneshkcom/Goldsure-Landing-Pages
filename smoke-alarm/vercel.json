{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "^/$", "has": [{ "type": "host", "value": "smokealarmpromo.goldsure.com.au" }], "dest": "/promo/index.html" },
    { "src": "^/thank-you/?$", "has": [{ "type": "host", "value": "smokealarmpromo.goldsure.com.au" }], "dest": "/promo/thank-you/index.html" },
    { "src": "^/promo/?$", "has": [{ "type": "host", "value": "smokealarms.goldsure.com.au" }], "status": 308, "headers": { "Location": "https://smokealarmpromo.goldsure.com.au/" } },
    { "src": "^/promo/thank-you/?$", "has": [{ "type": "host", "value": "smokealarms.goldsure.com.au" }], "status": 308, "headers": { "Location": "https://smokealarmpromo.goldsure.com.au/thank-you" } },
    { "handle": "filesystem" }
  ]
}
